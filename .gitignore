# SeenLow — Git ignore rules

# Environment variables and secrets
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
.env.vercel
!.env.example

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Build and coverage output
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Runtime and debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local database / temporary artifacts
*.sqlite
*.sqlite3
*.db
.tmp/
tmp/

# Vercel local project metadata
.vercel/

# Testing artifacts
playwright-report/
test-results/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE/editor local settings
.idea/
.vscode/
*.swp
*.swo
*~

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.p8
AuthKey_*.p8

# Archives
*.zip
*.tar
*.tar.gz

# Capacitor / native (local Mac build artifacts; commit ios/ project sources when generated)
*.mobileprovision
*.xcuserstate
ios/App/Pods/
ios/DerivedData/
android/.gradle/
android/app/build/
android/build/
