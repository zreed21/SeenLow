# ---------------------------------------------------------------------------
# SeenLow Environment Example
# Copy this file to `.env` and fill in your real values.
# IMPORTANT: never commit real secrets. Commit `.env.example` only.
# ---------------------------------------------------------------------------

# Database (Neon / Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Public app URL
NEXT_PUBLIC_APP_URL=https://seenlow.com

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STATEMENT_DESCRIPTOR=SEENLOW
STRIPE_CAPTURE_METHOD=automatic
STRIPE_TAX_ENABLED=0
NEXT_PUBLIC_MERCHANT_NAME=SeenLow

# Shared API / CORS
API_ALLOWED_ORIGINS=https://seenlow.com,https://www.seenlow.com
API_SHARED_KEY=replace-with-shared-api-key

# Auth
AUTH_SECRET=replace-with-long-random-secret

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=SeenLow <support@seenlow.com>

# Optional AI Source-Risk Review
OPENAI_API_KEY=sk-...
OPENAI_SOURCE_RISK_MODEL=gpt-4o-mini

# Pricing Defaults
BUSINESS_MARGIN_RATE=0.10
STRIPE_PROCESSING_RATE=0.029
STRIPE_PROCESSING_FIXED=0.30

# Admin bootstrap / scripts
GO_LIVE_ADMIN_PASSWORD=replace-with-admin-password
