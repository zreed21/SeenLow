# SeenLow environment template
# Copy this file to .env.local for local development.
# Never commit real credentials or connection strings.

# -----------------------------------------------------------------------------
# Database — use ONE of these. Vercel/Neon generally supplies DATABASE_URL.
# -----------------------------------------------------------------------------
DATABASE_URL=
POSTGRES_URL=

# -----------------------------------------------------------------------------
# Authentication
# Generate a strong value, for example: openssl rand -base64 48
# -----------------------------------------------------------------------------
AUTH_SECRET=

# -----------------------------------------------------------------------------
# Stripe — leave blank to use the app's safe simulation mode
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STATEMENT_DESCRIPTOR=SEENLOW
STRIPE_CAPTURE_METHOD=automatic
STRIPE_TAX_ENABLED=0

# Internal estimate used to build processing costs into reseller sale prices
STRIPE_PROCESSING_PERCENT=2.9
STRIPE_PROCESSING_FIXED_CENTS=30

# -----------------------------------------------------------------------------
# Public application identity
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://seenlow.com
NEXT_PUBLIC_MERCHANT_NAME=SeenLow

# -----------------------------------------------------------------------------
# Shared API / CORS for seenlow.com and www.seenlow.com
# -----------------------------------------------------------------------------
API_ALLOWED_ORIGINS=https://seenlow.com,https://www.seenlow.com
API_SHARED_KEY=

# -----------------------------------------------------------------------------
# Email digest / SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SeenLow <support@seenlow.com>

# -----------------------------------------------------------------------------
# Optional source-risk AI review
# AI can only lower trust or hold a source; it cannot approve one.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_SOURCE_RISK_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Optional admin/UI hints
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SMTP_CONFIGURED=
